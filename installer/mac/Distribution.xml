<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>RavenClipper</title>
    <background file="background.png" alignment="topleft" scaling="none" mime-type="image/png"/>
    <background-darkAqua file="background.png" alignment="topleft" scaling="none" mime-type="image/png"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.ravenclipper.vst3"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.ravenclipper.vst3" visible="false">
        <pkg-ref id="com.ravenclipper.vst3"/>
    </choice>
    <pkg-ref id="com.ravenclipper.vst3" onConclusion="none">RavenClipper-component.pkg</pkg-ref>
</installer-gui-script>
